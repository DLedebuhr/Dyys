[sub_resource type="GDScript" id="GDScript_prkmj"]
script/source = "extends Button

# Configurações de escala e tempo de transição
@export var hover_scale := Vector2(1.1, 1.1)  # Tamanho ao passar o mouse
@export var normal_scale := Vector2(1.0, 1.0) # Tamanho padrão
@export var pressed_scale := Vector2(0.85, 0.85) # Tamanho ao clicar

var scale_tween: Tween
var click_tween: Tween

func _ready() -> void:
	# Define o ponto de rotação/escala para o centro do botão
	pivot_offset = size / 2.0
	
	# Garante que o Pivot continue no centro caso o layout mude
	item_rect_changed.connect(func(): pivot_offset = size / 2.0)
	
	# Conecta os sinais de mouse
	mouse_entered.connect(_on_mouse_entered)
	mouse_exited.connect(_on_mouse_exited)
	pressed.connect(_on_pressed)

func _on_mouse_entered() -> void:
	# Anima o aumento de tamanho de forma fluida
	if scale_tween and scale_tween.is_running():
		scale_tween.kill()
		
	scale_tween = create_tween()
	scale_tween.tween_property(self, \"scale\", hover_scale, 0.15)\\
		.set_trans(Tween.TRANS_BACK)\\
		.set_ease(Tween.EASE_OUT)

func _on_mouse_exited() -> void:
	# Retorna ao tamanho original ao tirar o mouse
	if scale_tween and scale_tween.is_running():
		scale_tween.kill()
		
	scale_tween = create_tween()
	scale_tween.tween_property(self, \"scale\", normal_scale, 0.15)\\
		.set_trans(Tween.TRANS_SINE)\\
		.set_ease(Tween.EASE_OUT)

func _on_pressed() -> void:
	
	if scale_tween and scale_tween.is_running():
		scale_tween.kill()

	# Transição paralela: diminui e faz fade out
	click_tween = create_tween().set_parallel(true)
	
	# 1. Encolhe
	click_tween.tween_property(self, \"scale\", pressed_scale, 0.2)\\
		.set_trans(Tween.TRANS_QUAD)\\
		.set_ease(Tween.EASE_IN)
			
"

